# API Keys for LLM Providers
# OpenAI Chat Completions API (GPT-4, o-series, etc.)
OPENAI_API_KEY=sk-...
# OpenAI Responses API for Codex models (optional - uses OPENAI_API_KEY if not set)
OPENAI_CODEX_API_KEY=
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Security
# CRITICAL: Set a secure random string for admin authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=your-secure-admin-key-change-this

# CORS Configuration
# Comma-separated list of allowed origins (NEVER use * in production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Database
DATABASE_URL=sqlite:///./realbench.db

# API Settings (DEPRECATED - use ADMIN_API_KEY instead)
# API_KEY=your-secret-api-key
ENVIRONMENT=development

# Model Settings
DEFAULT_JUDGE_MODEL=gpt-4o
MAX_EVAL_TIMEOUT=300

# Ensemble Safety Detection (Option 1: Multi-Model Ensemble)
# Enable high-confidence multi-model safety detection with adversarial probing
# When enabled, uses 3 specialized judge models + active validation
# Increases confidence from ~65-70% to ~85-92% but costs 3-4x more API calls
USE_ENSEMBLE_SAFETY_DETECTOR=false
ENABLE_ADVERSARIAL_PROBING=true
SAFETY_COST_LIMIT=1.0  # Max USD per safety evaluation to prevent runaway costs
